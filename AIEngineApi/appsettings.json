{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AIEngineDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "B2BTest": "Server=(localdb)\\MSSQLLocalDB;Database=B2B_Test;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ScanHistory": {
    "Enabled":              true,
    "RetentionDays":        30,
    "CleanupIntervalHours": 6,
    "CleanupBatchSize":     5000,
    "InterBatchDelayMs":    200
  }
}
